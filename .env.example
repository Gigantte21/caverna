NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://user:password@host:5432/caverna

JWT_SECRET=troca-por-uma-string-longa-e-aleatoria-aqui
ADMIN_TOKEN=troca-por-outro-token-secreto-aqui

BASE_URL=https://seudominio.com.br

R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY=sua_access_key
R2_SECRET_KEY=sua_secret_key
R2_BUCKET=caverna-midias
R2_PUBLIC_URL=https://midias.seudominio.com.br

# Loja pública (Asaas). Sem as duas chaves a loja mostra os produtos mas não vende.
ASAAS_ENV=sandbox
ASAAS_API_KEY=sua_chave_do_asaas
ASAAS_WEBHOOK_TOKEN=token_que_voce_cadastrou_no_webhook
FRETE_FIXO=15
